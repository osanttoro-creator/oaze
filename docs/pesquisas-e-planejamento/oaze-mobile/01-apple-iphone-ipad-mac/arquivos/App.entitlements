<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ios/App/App/App.entitlements
  O Xcode gera este arquivo ao ligar as capacidades em Signing & Capabilities.
  Use este conteúdo para conferir, não para substituir às cegas.

  Push da v2: ligar "Push Notifications" no Xcode, que acrescenta
  aps-environment (development no build de teste, production no da loja).
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:oaze.site</string>
		<string>webcredentials:oaze.site</string>
	</array>
</dict>
</plist>
