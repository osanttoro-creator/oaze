{
  "appId": "site.oaze.app",
  "appName": "OAZE",
  "webDir": "www",
  "backgroundColor": "#071822",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
